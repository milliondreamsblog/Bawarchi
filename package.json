{
  "name": "bawarchie",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @bawarchie/web dev",
    "build:web": "pnpm --filter @bawarchie/web build",
    "seed": "pnpm --filter @bawarchie/web seed",
    "seed:demo": "pnpm --filter @bawarchie/web seed:demo",
    "probe": "pnpm --filter @bawarchie/web probe"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
